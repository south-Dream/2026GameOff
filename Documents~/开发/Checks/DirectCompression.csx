var ui=UnityEngine.Object.FindObjectOfType<PlaneShift.UIMgr>();var save=PlayerPrefs.GetString("PlayerRecord","");bool had=PlayerPrefs.HasKey("PlayerRecord");bool bg=Application.runInBackground;Application.runInBackground=true;EditorApplication.isPaused=false;ui.helpUI.Hide();ui.settingsUI.Hide();ui.guide.enabled=false;ui.guideUI.Hide();
var flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;var file=System.IO.Path.Combine(Application.dataPath,"../Library/DirectCompression-check.log");System.IO.File.WriteAllText(file,"Direct compression camera regression\n");var views=(PlaneShift.ViewDirection[])Enum.GetValues(typeof(PlaneShift.ViewDirection));int phase=0,index=0,last=-1;double started=EditorApplication.timeSinceStartup;PlaneShift.SpaceManager space=null;PlaneShift.PlayerController mover=null;Camera cam=null;Vector3 original=Vector3.zero,target=Vector3.zero;
Action<bool,string> check=(ok,name)=>{if(!ok)throw new Exception(name);System.IO.File.AppendAllText(file,"PASS "+name+"\n");};
Action<string> visible=name=>{var p=cam.WorldToViewportPoint(space.Player.Position+Vector3.up*.8f);check(p.z>0&&p.x>.1f&&p.x<.9f&&p.y>.1f&&p.y<.9f,name+" visible "+p);};
Action restore=()=>{Application.runInBackground=bg;if(had)PlayerPrefs.SetString("PlayerRecord",save);else PlayerPrefs.DeleteKey("PlayerRecord");PlayerPrefs.Save();};
EditorApplication.CallbackFunction tick=null;tick=()=>{try{if(!EditorApplication.isPlaying){EditorApplication.update-=tick;restore();return;}if(last==Time.frameCount)return;last=Time.frameCount;if(EditorApplication.timeSinceStartup-started>25)throw new Exception("Timeout");
if(phase==0){ui.PlayLevel(0);phase=1;return;}if(phase==1){if(ui.levels.Current==null||ui.levels.CurrentIndex!=0)return;space=ui.levels.Current.Space;if(space.Map.Data.roads.Count==0)return;mover=(PlaneShift.PlayerController)typeof(PlaneShift.PlayerManager).GetField("controller",flags).GetValue(space.Player);cam=space.View.GetComponentInChildren<Camera>();phase=2;}
if(phase==2){space.ResetPlayer();space.Data.direction=views[index];space.View.ChangeView(views[index],false,true);space.View.Tick(space.Player.Position+Vector3.up*.7f);visible(views[index]+" world");original=space.Player.Position;typeof(PlaneShift.SpaceManager).GetMethod("Compress",flags).Invoke(space,null);check(space.Data.mode==PlaneShift.SpaceMode.Changing,"direct compression accepts down without up "+views[index]);phase=3;return;}
if(phase==3){if(space.Data.mode!=PlaneShift.SpaceMode.Flat||space.View.IsChanging)return;visible(views[index]+" flat");target=space.Player.Position;target[space.Data.axis==PlaneShift.SpaceAxis.X?2:0]+=.4f;phase=4;}
if(phase==4){var d=target-space.Player.Position;d.y=0;if(d.magnitude>.06f){mover.Move(d.normalized,space.Player.Data,space.Data.axis==PlaneShift.SpaceAxis.Y,space.Data.axis,space.Map.Plane);space.Player.RefreshGround();return;}typeof(PlaneShift.SpaceManager).GetMethod("TryExpand",flags).Invoke(space,null);check(space.Data.mode==PlaneShift.SpaceMode.Changing,"expand accepted "+views[index]);phase=5;return;}
if(phase==5){if(space.Data.mode!=PlaneShift.SpaceMode.World||space.View.IsChanging)return;visible(views[index]+" expanded");check(Mathf.Abs(space.Player.Position[(int)space.Data.axis]-original[(int)space.Data.axis])<.01f,"same source lost axis retained "+views[index]);index++;phase=2;started=EditorApplication.timeSinceStartup;if(index==views.Length){check(!Enum.GetNames(typeof(PlaneShift.SpaceMode)).Contains("Preview"),"preview state removed");System.IO.File.AppendAllText(file,"PASS all six camera directions direct compression movement and restoration\n");EditorApplication.update-=tick;restore();}}
}catch(Exception e){System.IO.File.AppendAllText(file,"FAIL "+e+"\n");EditorApplication.update-=tick;restore();}};EditorApplication.update+=tick;return "Started six direction camera and direct compression check";
