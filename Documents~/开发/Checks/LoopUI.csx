var ui=UnityEngine.Object.FindObjectOfType<PlaneShift.UIMgr>();
var flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;
var log=System.IO.Path.GetFullPath("Library/LoopUI-check.log");System.IO.File.WriteAllText(log,"Loop restrictions, recall and scroll\n");
Action<bool,string> check=(ok,name)=>{if(!ok)throw new Exception(name);System.IO.File.AppendAllText(log,"PASS "+name+"\n");};
ui.helpUI.Hide();ui.settingsUI.Hide();ui.guide.enabled=false;ui.guideUI.Hide();ui.PlayLevel(10);
int phase=0,last=-1;double started=EditorApplication.timeSinceStartup;Vector3 before=Vector3.zero;PlaneShift.SpaceManager space=null;
EditorApplication.CallbackFunction tick=null;tick=()=>{try{
if(!EditorApplication.isPlaying){EditorApplication.update-=tick;return;}if(last==Time.frameCount)return;last=Time.frameCount;if(EditorApplication.timeSinceStartup-started>30)throw new Exception("Timeout");
if(phase==0){if(ui.levels.Current==null||ui.levels.CurrentIndex!=10)return;space=ui.levels.Current.Space;if(space.Map.Data.roads.Count==0)return;space.SetControl(true);
foreach(var direction in new[]{PlaneShift.ViewDirection.Top,PlaneShift.ViewDirection.Bottom}){space.Data.direction=direction;space.View.ChangeView(direction,false,true);space.View.Tick(space.Player.Position+Vector3.up*.7f);var p=space.View.GetComponent<Camera>().WorldToViewportPoint(space.Player.Position+Vector3.up*.8f);check(p.x>.1&&p.x<.9&&p.y>.1&&p.y<.9&&p.z>0,"Player visible in "+direction);}
space.Data.direction=PlaneShift.ViewDirection.North;space.View.ChangeView(space.Data.direction,false,true);
var lift=space.Map.GetComponentsInChildren<PlaneShift.MapMechanism>().First(m=>m.name=="LiftA");lift.StartMove();lift.Tick(lift.Data.duration);((PlaneShift.MapController)typeof(PlaneShift.MapManager).GetField("controller",flags).GetValue(space.Map)).RefreshRoads();space.Player.SetWorld(new Vector3(18,6.03f,14));Physics.SyncTransforms();space.Player.UpdateInteraction(true);check(space.Player.Target.name=="CallA","Fixed recall button selected");before=space.Player.Position;check(space.Player.TryInteract(),"F accepts raised lift recall");phase=1;return;}
if(phase==1){if(space.Map.IsMoving)return;check(Vector3.Distance(before,space.Player.Position)<.1f,"Recall leaves non-boarded player on platform");check(!space.Map.GetComponentsInChildren<PlaneShift.MapMechanism>().First(m=>m.name=="LiftA").IsRaised,"Lift returned to lower floor");ui.levelUI.Show();Canvas.ForceUpdateCanvases();ui.levelUI.Select(10);var sr=ui.levelUI.GetComponentInChildren<UnityEngine.UI.ScrollRect>(true);check(sr.horizontal&&!sr.vertical&&sr.horizontalScrollbar==null&&sr.verticalScrollbar==null,"Horizontal scroll without scrollbars");var fixedPanel=ui.levelUI.transform.Find("Description");var fixedPosition=fixedPanel.position;var node=(RectTransform)sr.content.Find("Level11");var p=sr.viewport.InverseTransformPoint(node.position);check(Mathf.Abs(p.x)<sr.viewport.rect.width/2,"Selected last node revealed");sr.horizontalNormalizedPosition=.5f;var old=sr.content.anchoredPosition;var e=new UnityEngine.EventSystems.PointerEventData(UnityEngine.EventSystems.EventSystem.current);e.scrollDelta=new Vector2(0,-1);sr.OnScroll(e);check(sr.content.anchoredPosition.x!=old.x&&sr.content.anchoredPosition.y==old.y,"Mouse wheel moves horizontally");old=sr.content.anchoredPosition;e.button=UnityEngine.EventSystems.PointerEventData.InputButton.Left;e.position=RectTransformUtility.WorldToScreenPoint(null,sr.viewport.position);sr.OnInitializePotentialDrag(e);sr.OnBeginDrag(e);e.position+=new Vector2(-120,0);sr.OnDrag(e);sr.OnEndDrag(e);check(sr.content.anchoredPosition.x!=old.x,"Pointer drag moves route");sr.StopMovement();check(fixedPanel.position==fixedPosition,"Right description stays fixed");ui.settingsUI.SetLanguage("en");check(ui.levelUI.transform.Find("LevelTitle").GetComponent<UnityEngine.UI.Text>().text.Contains("Looping Courtyard"),"English level title");ScreenCapture.CaptureScreenshot(System.IO.Path.GetFullPath("Library/LoopSelectEnglish.png"));phase=2;return;}
if(phase==2){ui.settingsUI.SetLanguage("zh-CN");ScreenCapture.CaptureScreenshot(System.IO.Path.GetFullPath("Library/LoopSelectChinese.png"));phase=3;return;}
ui.levelUI.Play();check(ui.levels.CurrentIndex==10,"Selected node loads Level11");System.IO.File.AppendAllText(log,"PASS all loop UI checks\n");EditorApplication.update-=tick;
}catch(Exception ex){System.IO.File.AppendAllText(log,"FAIL "+ex.Message+"\n");EditorApplication.update-=tick;}};EditorApplication.update+=tick;return "Started loop UI check";
