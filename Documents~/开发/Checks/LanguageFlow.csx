// Run in Play mode after route checks, without saving scene changes
var ui=UnityEngine.Object.FindObjectOfType<PlaneShift.UIMgr>();
var flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;
Action<bool,string> check=(ok,name)=>{if(!ok)throw new Exception(name);};
var log=new System.Text.StringBuilder();
var data=ui.languageData;
foreach(var code in data.languages)foreach(var entry in data.entries)check(!string.IsNullOrWhiteSpace(PlaneShift.LanguageManager.GetInLanguage(entry.id,code)),entry.id);
var word=new PlaneShift.LanguageManager.Word("level.04.title");
check(PlaneShift.LanguageManager.GetInLanguage("ui.levelTitle","zh-CN",4,word)=="4.分岔中庭","Chinese title format");
check(PlaneShift.LanguageManager.GetInLanguage("ui.levelTitle","en",4,word)=="4. Forked Courtyard","English nested title");
bool missing=false;try{PlaneShift.LanguageManager.Get("missing.test");}catch(System.Collections.Generic.KeyNotFoundException){missing=true;}check(missing,"Missing IDs must throw");
string original=PlaneShift.LanguageManager.Current;bool invalid=false;try{PlaneShift.LanguageManager.SetLanguage("missing-language");}catch(ArgumentException){invalid=true;}check(invalid&&PlaneShift.LanguageManager.Current==original,"Invalid language changes current state");
ui.startUI.Show();ui.settingsUI.Show();
ui.settingsUI.SetLanguage("en");
check(ui.startUI.transform.Find("StartButton/Label").GetComponent<UnityEngine.UI.Text>().text=="Play","Static UI does not change");
ui.settingsUI.transform.Find("CloseButton").GetComponent<UnityEngine.UI.Button>().onClick.Invoke();
check(!ui.settingsUI.gameObject.activeSelf&&ui.startUI.gameObject.activeSelf,"Close settings changes main panel");
ui.levelUI.Show();ui.levelUI.Select(3);ui.settingsUI.Show();ui.settingsUI.SetLanguage("zh-CN");
check(ui.levelUI.transform.Find("LevelTitle").GetComponent<UnityEngine.UI.Text>().text=="4.分岔中庭","Selected level does not change language");
ui.settingsUI.transform.Find("ReturnButton").GetComponent<UnityEngine.UI.Button>().onClick.Invoke();
check(ui.startUI.gameObject.activeSelf&&!ui.levelUI.gameObject.activeSelf&&!ui.settingsUI.gameObject.activeSelf,"Settings return menu failed");
ui.gameUI.Show();
UnityLightFrame.EventCenter.Instance.TriggerEvent(UnityLightFrame.E_EventType.ModeChanged,"mode.flat");
UnityLightFrame.EventCenter.Instance.TriggerEvent(UnityLightFrame.E_EventType.Notice,"notice.unfolded");
UnityLightFrame.EventCenter.Instance.TriggerEvent(UnityLightFrame.E_EventType.InteractionChanged,new PlaneShift.InteractionInfo{visible=true,available=true,text="interact.slide"});
float end=(float)typeof(PlaneShift.GameUI).GetField("noticeEnd",flags).GetValue(ui.gameUI);
ui.settingsUI.SetLanguage("en");
check(ui.gameUI.transform.Find("ControlsText").GetComponent<UnityEngine.UI.Text>().text.Contains("Unfold"),"Mode overwritten by static text");
check(ui.gameUI.transform.Find("NoticeText").GetComponent<UnityEngine.UI.Text>().text=="Space unfolded","Notice language stale");
check((float)typeof(PlaneShift.GameUI).GetField("noticeEnd",flags).GetValue(ui.gameUI)==end,"Language reset notice timeout");
check(ui.gameUI.transform.Find("InteractionPrompt/InteractionText").GetComponent<UnityEngine.UI.Text>().text.Contains("Shift bridge"),"Interaction nested word stale");
UnityLightFrame.EventCenter.Instance.TriggerEvent(UnityLightFrame.E_EventType.LevelCompleted);
ui.settingsUI.SetLanguage("zh-CN");
check(!ui.gameUI.transform.Find("InteractionPrompt").gameObject.activeSelf&&ui.gameUI.transform.Find("NoticeText").GetComponent<UnityEngine.UI.Text>().text=="","Language resurrected completed interaction or notice");
ui.helpUI.Show();ui.settingsUI.SetLanguage("en");check(ui.helpUI.transform.Find("Body").GetComponent<UnityEngine.UI.Text>().text.Contains("Arrow Keys"),"Help language stale");ui.helpUI.Hide();
ui.guideUI.Show(ui.guide.data.entries[0],true);
ui.settingsUI.SetLanguage("zh-CN");check(ui.guideUI.title.text=="迈出第一步","Guide language stale");ui.guideUI.Hide();
ui.settingsUI.SetLanguage(original);ui.startUI.Show();
return "PASS all 84 IDs, nested args, strict lookup, live text, notice lifetime, completion, settings close/menu, help and guide";

