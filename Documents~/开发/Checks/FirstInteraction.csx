var ui=UnityEngine.Object.FindObjectOfType<PlaneShift.UIMgr>();bool had=PlayerPrefs.HasKey("PlayerRecord");var save=PlayerPrefs.GetString("PlayerRecord","");bool bg=Application.runInBackground;Application.runInBackground=true;EditorApplication.isPaused=false;
ui.helpUI.Hide();ui.settingsUI.Hide();ui.record.Data.steps.Clear();for(int i=0;i<=5;i++)ui.record.Data.steps.Add((PlaneShift.GuideStep)i);
var file=System.IO.Path.Combine(Application.dataPath,"../Library/FirstInteraction-check.log");System.IO.File.WriteAllText(file,"First interaction live check\n");var flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;int stage=0,last=-1;double since=EditorApplication.timeSinceStartup,pauseStart=0;PlaneShift.SpaceManager space=null;PlaneShift.PlayerController mover=null;Vector3 pausedRoad=Vector3.zero;PlaneShift.MapMechanism mech=null;
Action<bool,string> check=(ok,name)=>{if(!ok)throw new Exception(name);System.IO.File.AppendAllText(file,"PASS "+name+"\n");};
Action restore=()=>{Application.runInBackground=bg;if(had)PlayerPrefs.SetString("PlayerRecord",save);else PlayerPrefs.DeleteKey("PlayerRecord");PlayerPrefs.Save();};
EditorApplication.CallbackFunction tick=null;tick=()=>{try{if(!EditorApplication.isPlaying){EditorApplication.update-=tick;restore();return;}if(last==Time.frameCount)return;last=Time.frameCount;if(EditorApplication.timeSinceStartup-since>35)throw new Exception("Timeout stage "+stage);
if(stage==0){ui.PlayLevel(0);stage=1;return;}
if(stage==1||stage==6){if(ui.levels.Current==null||ui.levels.CurrentIndex!=(stage==6?2:0))return;space=ui.levels.Current.Space;if(space.Map.Data.roads.Count==0)return;mover=(PlaneShift.PlayerController)typeof(PlaneShift.PlayerManager).GetField("controller",flags).GetValue(space.Player);mech=space.Map.GetComponentsInChildren<PlaneShift.MapMechanism>().First(m=>m.name==(stage==6?"CornerBridge":"PracticeSlide"));stage++;return;}
if(stage==2||stage==7){var delta=(stage==7?new Vector3(-13,6,1):new Vector3(-7,4,0))-space.Player.Position;delta.y=0;if(delta.magnitude>0.15f){mover.Move(delta.normalized,space.Player.Data,false,null,0);space.Player.RefreshGround();return;}space.Player.UpdateInteraction(true);
if(stage==7){check(!ui.guideUI.gameObject.activeSelf,"completed F lesson does not repeat for a different mechanism");check(ui.record.HasStep(PlaneShift.GuideStep.Interact),"record remains complete after level reload");ui.helpUI.Show();ui.settingsUI.Show();ui.helpUI.Hide();check(ui.levels.Paused&&!UnityLightFrame.InputManager.Instance.totalToggle,"closing help preserves settings pause");ui.settingsUI.Hide();check(!ui.levels.Paused&&UnityLightFrame.InputManager.Instance.totalToggle,"combined pauses restore input");System.IO.File.AppendAllText(file,"PASS first encounter masks successful action pause persistence and repeat checks\n");EditorApplication.update-=tick;restore();return;}
check(ui.guideUI.gameObject.activeSelf&&ui.guideUI.readingPanel.activeSelf,"first available mechanism opens reading before F");
check(!UnityLightFrame.InputManager.Instance.GetInput(UnityLightFrame.E_InputEventType.Interact).isActive,"same-frame F is locked by reading");check(space.Player.LockedTarget!=null,"target locked");
ui.settingsUI.Show();ui.settingsUI.Hide();check(!UnityLightFrame.InputManager.Instance.GetInput(UnityLightFrame.E_InputEventType.Interact).isActive,"settings cannot bypass reading");ui.guideUI.Continue();stage=3;return;}
if(stage==3){if(!UnityLightFrame.InputManager.Instance.GetInput(UnityLightFrame.E_InputEventType.Interact).isActive)return;check(Enum.GetValues(typeof(UnityLightFrame.E_InputEventType)).Cast<UnityLightFrame.E_InputEventType>().Count(k=>UnityLightFrame.InputManager.Instance.GetInput(k).isActive)==1,"practice only enables F");check(!ui.record.HasStep(PlaneShift.GuideStep.Interact),"opening explanation does not finish record");space.Player.UpdateInteraction(true);check(space.Player.TryInteract(),"accepted actual interaction");check(!ui.record.HasStep(PlaneShift.GuideStep.Interact),"accepted request waits for movement completion");ui.settingsUI.Show();pausedRoad=mech.Road.transform.position;pauseStart=EditorApplication.timeSinceStartup;stage=4;return;}
if(stage==4){if(EditorApplication.timeSinceStartup-pauseStart<0.25)return;check((mech.Road.transform.position-pausedRoad).sqrMagnitude<0.00001f,"settings freezes mechanism movement");ui.settingsUI.Hide();stage=5;return;}
if(stage==5){if(space.Map.IsMoving||!ui.record.HasStep(PlaneShift.GuideStep.Interact))return;check(space.Player.LockedTarget==null,"successful completion releases target");var copy=ScriptableObject.CreateInstance<PlaneShift.RecordData>();JsonUtility.FromJsonOverwrite(PlayerPrefs.GetString("PlayerRecord"),copy);check(copy.steps.Contains(PlaneShift.GuideStep.Interact),"completed step saved");UnityEngine.Object.Destroy(copy);ui.startUI.Show();ui.PlayLevel(2);stage=6;since=EditorApplication.timeSinceStartup;return;}
}catch(Exception e){System.IO.File.AppendAllText(file,"FAIL "+e+"\n");EditorApplication.update-=tick;restore();}};EditorApplication.update+=tick;return "Started first-interaction guide live test";
