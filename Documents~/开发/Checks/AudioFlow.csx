// Play-mode audio lifecycle check, using the player's accepted interaction entry
var ui=UnityEngine.Object.FindObjectOfType<PlaneShift.UIMgr>();
var flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;
var mixer=AssetDatabase.LoadAssetAtPath<UnityEngine.Audio.AudioMixer>("Assets/Resources/Audio/GameAudio.mixer");
var music=ui.transform.Find("Music").GetComponent<AudioSource>();
var passed=ui.transform.Find("LevelSound").GetComponent<AudioSource>();
var log=System.IO.Path.GetFullPath("Library/AudioFlow-check.log");System.IO.File.WriteAllText(log,"Audio integration\n");
Action<bool,string> check=(ok,name)=>{if(!ok)throw new Exception(name);System.IO.File.AppendAllText(log,"PASS "+name+"\n");};
ui.helpUI.Hide();ui.settingsUI.Hide();ui.guide.enabled=false;ui.guideUI.Hide();Application.runInBackground=true;
check(music.clip.length==80&&music.loop&&music.isPlaying,"80 second BGM plays");
float db;ui.settingsUI.SetMusic(0);ui.settingsUI.SetSound(.65f);mixer.GetFloat("BgmVolume",out db);check(db==-80,"BGM mute");mixer.GetFloat("SfxVolume",out db);check(Mathf.Abs(db-20*Mathf.Log10(.65f))<.01f,"SFX independent from BGM");
ui.settingsUI.SetMusic(.4f);ui.settingsUI.SetSound(0);mixer.GetFloat("SfxVolume",out db);check(db==-80,"SFX mute");mixer.GetFloat("BgmVolume",out db);check(Mathf.Abs(db-20*Mathf.Log10(.4f))<.01f,"BGM independent from SFX");ui.settingsUI.SetSound(.7f);
ui.startUI.Show();ui.PlayLevel(0);
int phase=0,last=-1;double since=EditorApplication.timeSinceStartup;double pauseTime=0;Vector3 pausedPosition=Vector3.zero;int pausedSample=0;PlaneShift.SpaceManager space=null;PlaneShift.MapMechanism mechanism=null;AudioSource source=null;float musicTime=0;
EditorApplication.CallbackFunction tick=null;tick=()=>{try{
 if(!EditorApplication.isPlaying){EditorApplication.update-=tick;return;}if(last==Time.frameCount)return;last=Time.frameCount;if(EditorApplication.timeSinceStartup-since>25)throw new Exception("Timeout phase "+phase);
 if(phase==0){if(ui.levels.Current==null||ui.levels.CurrentIndex!=0||!ui.levels.Current.Space.CanExit)return;space=ui.levels.Current.Space;mechanism=space.Map.GetComponentsInChildren<PlaneShift.MapMechanism>().First(m=>m.name=="PracticeSlide");source=(AudioSource)typeof(PlaneShift.MapMechanism).GetField("audioSource",flags).GetValue(mechanism);space.Player.SetWorld(new Vector3(-7,4,0));space.Player.RefreshGround();space.Player.UpdateInteraction(true);check(space.Player.Target is PlaneShift.MechanismButton,"nearby F selects mechanism");check(space.Player.TryInteract(),"F accepts mechanism");check(source.isPlaying&&source.clip.name=="SlideLoop"&&source.loop,"mechanism starts its configured loop");pauseTime=EditorApplication.timeSinceStartup;phase=1;return;}
 if(phase==1){if(EditorApplication.timeSinceStartup-pauseTime<.15)return;ui.settingsUI.Show();pausedPosition=mechanism.Road.transform.position;pausedSample=source.timeSamples;pauseTime=EditorApplication.timeSinceStartup;phase=2;return;}
 if(phase==2){if(EditorApplication.timeSinceStartup-pauseTime<.25)return;check(!source.isPlaying&&mechanism.IsMoving,"settings pauses movement sound");check((mechanism.Road.transform.position-pausedPosition).sqrMagnitude<.000001f&&Math.Abs(source.timeSamples-pausedSample)<8,"pause retains mechanism and audio position");ui.settingsUI.Hide();check(source.isPlaying,"closing settings resumes loop");phase=3;return;}
 if(phase==3){if(space.Map.IsMoving)return;check(source.isPlaying,"arrival sound plays");space.Player.UpdateInteraction(true);check(space.Player.TryInteract(),"mechanism can start again");space.ResetPlayer();check(!source.isPlaying&&!mechanism.IsMoving,"reset stops loop");space.Player.SetWorld(new Vector3(-7,4,0));space.Player.RefreshGround();space.Player.UpdateInteraction(true);check(space.Player.TryInteract(),"mechanism starts before unloading");ui.startUI.Show();phase=4;return;}
 if(phase==4){check(source==null||!source.isPlaying,"unloading stops old mechanism audio");check(music.isPlaying,"menu retains BGM");ui.PlayLevel(0);phase=5;return;}
 if(phase==5){if(ui.levels.Current==null||ui.levels.CurrentIndex!=0||!ui.levels.Current.Space.CanExit)return;space=ui.levels.Current.Space;var exit=space.Map.GetComponentInChildren<PlaneShift.LevelExit>();space.Player.SetWorld(exit.transform.position);space.Player.RefreshGround();space.Player.UpdateInteraction(true);check(space.Player.Target is PlaneShift.LevelExit,"F selects level exit");musicTime=music.time;check(space.Player.TryInteract(),"F accepts exit");check(passed.isPlaying&&passed.gameObject.activeInHierarchy,"accepted exit plays common clear sound");phase=6;return;}
 if(phase==6){if(ui.levels.Current==null||ui.levels.CurrentIndex!=1)return;check(passed.isPlaying,"clear tail survives next level loading");check(music.isPlaying&&music.time>=musicTime,"level change does not restart BGM");ui.startUI.Show();EditorApplication.update-=tick;System.IO.File.AppendAllText(log,"PASS audio integration complete\n");}
 }catch(Exception e){System.IO.File.AppendAllText(log,"FAIL "+e+"\n");EditorApplication.update-=tick;}};
EditorApplication.update+=tick;return "Audio lifecycle check started";
