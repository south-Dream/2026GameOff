// Editor import regression, restores the source workbook in finally
var source=PlaneShift.LanguageImporter.Source;
byte[] original=System.IO.File.ReadAllBytes(source);
var reports=new System.Collections.Generic.List<string>();
var fixtures=new[]{"","","","",""};
try{
 for(int i=0;i<4;i++){
  System.IO.File.WriteAllBytes(source,Convert.FromBase64String(fixtures[i]));bool rejected=false;
  try{PlaneShift.LanguageImporter.Import();}catch(System.IO.InvalidDataException){rejected=true;}
  if(!rejected)throw new Exception("Invalid workbook accepted: "+i);
  reports.Add("PASS invalid fixture "+i);
 }
 System.IO.File.WriteAllBytes(source,Convert.FromBase64String(fixtures[4]));
 PlaneShift.LanguageImporter.Import();var temp=AssetDatabase.LoadAssetAtPath<PlaneShift.LanguageData>(PlaneShift.LanguageImporter.Target);
 if(temp.languages.Length!=3||temp.entries[0].values[2]!="Français")throw new Exception("Additional language column failed");
 reports.Add("PASS additional language column");
}finally{System.IO.File.WriteAllBytes(source,original);PlaneShift.LanguageImporter.Import();}
return string.Join("\n",reports.ToArray());

